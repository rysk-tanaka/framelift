{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rysk-tanaka/workflows#b710d50e8e89e3f80986e25431680ed072819a2b",
    "group:allNonMajor",
    ":enablePreCommit"
  ],
  "enabledManagers": ["github-actions", "pep621", "pre-commit", "custom.regex"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on saturday"]
  },
  "packageRules": [
    {
      "description": "ty is beta: diagnostics can change between releases, so review each update on its own",
      "matchPackageNames": ["ty"],
      "groupName": "ty",
      "automerge": false
    },
    {
      "description": "Keep Pydantic AI packages in lockstep",
      "matchPackageNames": ["pydantic-ai-slim", "pydantic-evals"],
      "groupName": "pydantic-ai"
    },
    {
      "description": "The reusable workflows of rysk-tanaka/workflows stay out of the group, so their digest updates are automerged on their own by the shared preset",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["!rysk-tanaka/workflows"],
      "groupName": "github-actions"
    }
  ]
}
